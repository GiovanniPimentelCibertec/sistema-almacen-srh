<?xml version="1.0" encoding="UTF-8"?>
<!-- Reporte 1: despachos por sede y mes (salidas activas del almacén central agrupadas por sede).
     No es el consumo registrado por los hospitales (consumo_sede). -->
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="consumo_sede" pageWidth="595" pageHeight="842" columnWidth="535"
              leftMargin="30" rightMargin="30" topMargin="30" bottomMargin="30" whenNoDataType="NoDataSection">
    <style name="base" isDefault="true" fontName="SansSerif" fontSize="9"/>
    <parameter name="PERIODO" class="java.lang.String"/>
    <parameter name="GENERADO" class="java.lang.String"/>
    <parameter name="USUARIO" class="java.lang.String"/>
    <field name="sede" class="java.lang.String"/>
    <field name="codigo" class="java.lang.String"/>
    <field name="producto" class="java.lang.String"/>
    <field name="unidad" class="java.lang.String"/>
    <field name="pedido" class="java.lang.Integer"/>
    <field name="despachado" class="java.lang.Integer"/>
    <field name="salidas" class="java.lang.Integer"/>
    <!-- Salidas distintas (envíos) a la sede en el periodo; el mismo valor en todas las filas de la sede -->
    <field name="salidasSede" class="java.lang.Integer"/>
    <variable name="faltoProducto" class="java.lang.Integer">
        <variableExpression><![CDATA[$F{pedido} - $F{despachado}]]></variableExpression>
    </variable>
    <variable name="productosSede" class="java.lang.Integer" resetType="Group" resetGroup="sede" calculation="Count">
        <variableExpression><![CDATA[$F{codigo}]]></variableExpression>
    </variable>
    <group name="sede">
        <groupExpression><![CDATA[$F{sede}]]></groupExpression>
        <groupHeader>
            <band height="38">
                <textField>
                    <reportElement x="0" y="6" width="535" height="16" forecolor="#1F4E79"/>
                    <textElement><font size="11" isBold="true"/></textElement>
                    <textFieldExpression><![CDATA["Sede: " + $F{sede}]]></textFieldExpression>
                </textField>
                <frame>
                    <reportElement mode="Opaque" x="0" y="23" width="535" height="15" backcolor="#1F4E79"/>
                    <staticText><reportElement x="4" y="0" width="60" height="15" forecolor="#FFFFFF"/><textElement verticalAlignment="Middle"><font isBold="true"/></textElement><text><![CDATA[Código]]></text></staticText>
                    <staticText><reportElement x="66" y="0" width="200" height="15" forecolor="#FFFFFF"/><textElement verticalAlignment="Middle"><font isBold="true"/></textElement><text><![CDATA[Producto]]></text></staticText>
                    <staticText><reportElement x="268" y="0" width="45" height="15" forecolor="#FFFFFF"/><textElement verticalAlignment="Middle"><font isBold="true"/></textElement><text><![CDATA[Unidad]]></text></staticText>
                    <staticText><reportElement x="315" y="0" width="50" height="15" forecolor="#FFFFFF"/><textElement textAlignment="Right" verticalAlignment="Middle"><font isBold="true"/></textElement><text><![CDATA[Salidas]]></text></staticText>
                    <staticText><reportElement x="367" y="0" width="55" height="15" forecolor="#FFFFFF"/><textElement textAlignment="Right" verticalAlignment="Middle"><font isBold="true"/></textElement><text><![CDATA[Pedido]]></text></staticText>
                    <staticText><reportElement x="424" y="0" width="60" height="15" forecolor="#FFFFFF"/><textElement textAlignment="Right" verticalAlignment="Middle"><font isBold="true"/></textElement><text><![CDATA[Despachado]]></text></staticText>
                    <staticText><reportElement x="486" y="0" width="45" height="15" forecolor="#FFFFFF"/><textElement textAlignment="Right" verticalAlignment="Middle"><font isBold="true"/></textElement><text><![CDATA[Faltó]]></text></staticText>
                </frame>
            </band>
        </groupHeader>
        <groupFooter>
            <band height="20">
                <textField>
                    <reportElement x="0" y="3" width="535" height="14" forecolor="#555555"/>
                    <textElement><font isItalic="true"/></textElement>
                    <textFieldExpression><![CDATA[$V{productosSede} + ($V{productosSede} == 1 ? " producto distinto despachado en " : " productos distintos despachados en ") + $F{salidasSede} + ($F{salidasSede} == 1 ? " salida del almacén." : " salidas del almacén.")]]></textFieldExpression>
                </textField>
            </band>
        </groupFooter>
    </group>
    <title>
        <band height="78">
            <staticText>
                <reportElement x="0" y="0" width="535" height="22" forecolor="#1F4E79"/>
                <textElement><font size="16" isBold="true"/></textElement>
                <text><![CDATA[Almacén SRH S.A.C. - Despachos por sede]]></text>
            </staticText>
            <textField>
                <reportElement x="0" y="24" width="535" height="14"/>
                <textElement><font size="10"/></textElement>
                <textFieldExpression><![CDATA["Periodo: " + $P{PERIODO}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="0" y="40" width="535" height="14" forecolor="#555555"/>
                <textFieldExpression><![CDATA["Generado el " + $P{GENERADO} + " por " + $P{USUARIO} + ". Incluye solo salidas activas."]]></textFieldExpression>
            </textField>
            <staticText>
                <reportElement x="0" y="58" width="535" height="14" forecolor="#555555"/>
                <textElement><font isItalic="true"/></textElement>
                <text><![CDATA[Nota: muestra lo que el almacén central despachó a cada sede, no el consumo registrado por los hospitales.]]></text>
            </staticText>
        </band>
    </title>
    <detail>
        <band height="15">
            <textField><reportElement x="4" y="0" width="60" height="15"/><textElement verticalAlignment="Middle"/><textFieldExpression><![CDATA[$F{codigo}]]></textFieldExpression></textField>
            <textField><reportElement x="66" y="0" width="200" height="15"/><textElement verticalAlignment="Middle"/><textFieldExpression><![CDATA[$F{producto}]]></textFieldExpression></textField>
            <textField><reportElement x="268" y="0" width="45" height="15"/><textElement verticalAlignment="Middle"/><textFieldExpression><![CDATA[$F{unidad}]]></textFieldExpression></textField>
            <textField><reportElement x="315" y="0" width="50" height="15"/><textElement textAlignment="Right" verticalAlignment="Middle"/><textFieldExpression><![CDATA[$F{salidas}]]></textFieldExpression></textField>
            <textField><reportElement x="367" y="0" width="55" height="15"/><textElement textAlignment="Right" verticalAlignment="Middle"/><textFieldExpression><![CDATA[$F{pedido}]]></textFieldExpression></textField>
            <textField><reportElement x="424" y="0" width="60" height="15"/><textElement textAlignment="Right" verticalAlignment="Middle"><font isBold="true"/></textElement><textFieldExpression><![CDATA[$F{despachado}]]></textFieldExpression></textField>
            <textField><reportElement x="486" y="0" width="45" height="15" forecolor="#C0392B"/><textElement textAlignment="Right" verticalAlignment="Middle"/><textFieldExpression><![CDATA[$V{faltoProducto} > 0 ? String.valueOf($V{faltoProducto}) : "-"]]></textFieldExpression></textField>
        </band>
    </detail>
    <pageFooter>
        <band height="16">
            <textField>
                <reportElement x="0" y="2" width="535" height="14" forecolor="#777777"/>
                <textElement textAlignment="Right"/>
                <textFieldExpression><![CDATA["Página " + $V{PAGE_NUMBER}]]></textFieldExpression>
            </textField>
        </band>
    </pageFooter>
    <noData>
        <band height="80">
            <staticText>
                <reportElement x="0" y="0" width="535" height="22" forecolor="#1F4E79"/>
                <textElement><font size="16" isBold="true"/></textElement>
                <text><![CDATA[Almacén SRH S.A.C. - Despachos por sede]]></text>
            </staticText>
            <textField>
                <reportElement x="0" y="30" width="535" height="16"/>
                <textElement><font size="11"/></textElement>
                <textFieldExpression><![CDATA["No hay salidas registradas en el periodo " + $P{PERIODO} + "."]]></textFieldExpression>
            </textField>
        </band>
    </noData>
</jasperReport>
