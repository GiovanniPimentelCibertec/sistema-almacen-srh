<?xml version="1.0" encoding="UTF-8"?>
<!-- Reporte 2: productos activos con stock en su mínimo o por debajo, y cuánto comprar -->
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="productos_reponer" pageWidth="595" pageHeight="842" columnWidth="535"
              leftMargin="30" rightMargin="30" topMargin="30" bottomMargin="30" whenNoDataType="NoDataSection">
    <style name="base" isDefault="true" fontName="SansSerif" fontSize="9"/>
    <parameter name="GENERADO" class="java.lang.String"/>
    <parameter name="USUARIO" class="java.lang.String"/>
    <field name="codigo" class="java.lang.String"/>
    <field name="producto" class="java.lang.String"/>
    <field name="categoria" class="java.lang.String"/>
    <field name="unidad" class="java.lang.String"/>
    <field name="stock" class="java.lang.Integer"/>
    <field name="minimo" class="java.lang.Integer"/>
    <field name="sugerido" class="java.lang.Integer"/>
    <variable name="total" class="java.lang.Integer" calculation="Count">
        <variableExpression><![CDATA[$F{codigo}]]></variableExpression>
    </variable>
    <title>
        <band height="62">
            <staticText>
                <reportElement x="0" y="0" width="535" height="22" forecolor="#1F4E79"/>
                <textElement><font size="16" isBold="true"/></textElement>
                <text><![CDATA[Almacén SRH S.A.C. - Productos por reponer]]></text>
            </staticText>
            <staticText>
                <reportElement x="0" y="24" width="535" height="14"/>
                <textElement><font size="10"/></textElement>
                <text><![CDATA[Productos activos cuyo stock llegó a su stock mínimo o está por debajo.]]></text>
            </staticText>
            <textField>
                <reportElement x="0" y="40" width="535" height="14" forecolor="#555555"/>
                <textFieldExpression><![CDATA["Generado el " + $P{GENERADO} + " por " + $P{USUARIO} + "."]]></textFieldExpression>
            </textField>
        </band>
    </title>
    <columnHeader>
        <band height="17">
            <frame>
                <reportElement mode="Opaque" x="0" y="0" width="535" height="17" backcolor="#1F4E79"/>
                <staticText><reportElement x="4" y="0" width="58" height="17" forecolor="#FFFFFF"/><textElement verticalAlignment="Middle"><font isBold="true"/></textElement><text><![CDATA[Código]]></text></staticText>
                <staticText><reportElement x="64" y="0" width="180" height="17" forecolor="#FFFFFF"/><textElement verticalAlignment="Middle"><font isBold="true"/></textElement><text><![CDATA[Producto]]></text></staticText>
                <staticText><reportElement x="246" y="0" width="80" height="17" forecolor="#FFFFFF"/><textElement verticalAlignment="Middle"><font isBold="true"/></textElement><text><![CDATA[Categoría]]></text></staticText>
                <staticText><reportElement x="328" y="0" width="42" height="17" forecolor="#FFFFFF"/><textElement verticalAlignment="Middle"><font isBold="true"/></textElement><text><![CDATA[Unidad]]></text></staticText>
                <staticText><reportElement x="372" y="0" width="45" height="17" forecolor="#FFFFFF"/><textElement textAlignment="Right" verticalAlignment="Middle"><font isBold="true"/></textElement><text><![CDATA[Stock]]></text></staticText>
                <staticText><reportElement x="419" y="0" width="50" height="17" forecolor="#FFFFFF"/><textElement textAlignment="Right" verticalAlignment="Middle"><font isBold="true"/></textElement><text><![CDATA[Mínimo]]></text></staticText>
                <staticText><reportElement x="471" y="0" width="60" height="17" forecolor="#FFFFFF"/><textElement textAlignment="Right" verticalAlignment="Middle"><font isBold="true"/></textElement><text><![CDATA[Comprar]]></text></staticText>
            </frame>
        </band>
    </columnHeader>
    <detail>
        <band height="15">
            <textField><reportElement x="4" y="0" width="58" height="15"/><textElement verticalAlignment="Middle"/><textFieldExpression><![CDATA[$F{codigo}]]></textFieldExpression></textField>
            <textField><reportElement x="64" y="0" width="180" height="15"/><textElement verticalAlignment="Middle"/><textFieldExpression><![CDATA[$F{producto}]]></textFieldExpression></textField>
            <textField><reportElement x="246" y="0" width="80" height="15"/><textElement verticalAlignment="Middle"/><textFieldExpression><![CDATA[$F{categoria}]]></textFieldExpression></textField>
            <textField><reportElement x="328" y="0" width="42" height="15"/><textElement verticalAlignment="Middle"/><textFieldExpression><![CDATA[$F{unidad}]]></textFieldExpression></textField>
            <textField><reportElement x="372" y="0" width="45" height="15" forecolor="#C0392B"/><textElement textAlignment="Right" verticalAlignment="Middle"><font isBold="true"/></textElement><textFieldExpression><![CDATA[$F{stock}]]></textFieldExpression></textField>
            <textField><reportElement x="419" y="0" width="50" height="15"/><textElement textAlignment="Right" verticalAlignment="Middle"/><textFieldExpression><![CDATA[$F{minimo}]]></textFieldExpression></textField>
            <textField><reportElement x="471" y="0" width="60" height="15"/><textElement textAlignment="Right" verticalAlignment="Middle"><font isBold="true"/></textElement><textFieldExpression><![CDATA[$F{sugerido}]]></textFieldExpression></textField>
        </band>
    </detail>
    <summary>
        <band height="44">
            <textField>
                <reportElement x="0" y="8" width="535" height="14"/>
                <textElement><font isBold="true"/></textElement>
                <textFieldExpression><![CDATA["Total: " + $V{total} + ($V{total} == 1 ? " producto" : " productos") + " por reponer."]]></textFieldExpression>
            </textField>
            <staticText>
                <reportElement x="0" y="24" width="535" height="14" forecolor="#555555"/>
                <textElement><font isItalic="true"/></textElement>
                <text><![CDATA[Comprar = cantidad para volver al mínimo y cubrir un ciclo más de reposición (2 x mínimo - stock).]]></text>
            </staticText>
        </band>
    </summary>
    <noData>
        <band height="60">
            <staticText>
                <reportElement x="0" y="0" width="535" height="22" forecolor="#1F4E79"/>
                <textElement><font size="16" isBold="true"/></textElement>
                <text><![CDATA[Almacén SRH S.A.C. - Productos por reponer]]></text>
            </staticText>
            <staticText>
                <reportElement x="0" y="30" width="535" height="16"/>
                <textElement><font size="11"/></textElement>
                <text><![CDATA[No hay productos por reponer: todos están por encima de su stock mínimo.]]></text>
            </staticText>
        </band>
    </noData>
</jasperReport>
