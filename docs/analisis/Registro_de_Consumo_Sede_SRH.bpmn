<collaboration id="col_Sede"><participant id="pool_Sede" name="Registro de consumo en la sede hospitalaria" processRef="proc_Sede"/></collaboration>
<process id="proc_Sede" name="Registro de consumo en la sede hospitalaria" isExecutable="false"><laneSet id="ls_Sede">
<lane id="lane_Sede_E" name="Encargado de sede"><flowNodeRef>Sede_s1</flowNodeRef><flowNodeRef>Sede_t1</flowNodeRef><flowNodeRef>Sede_t3</flowNodeRef><flowNodeRef>Sede_t5</flowNodeRef><flowNodeRef>Sede_t7</flowNodeRef><flowNodeRef>Sede_g3</flowNodeRef><flowNodeRef>Sede_t9</flowNodeRef><flowNodeRef>Sede_e1</flowNodeRef></lane>
<lane id="lane_Sede_S" name="Sistema web"><flowNodeRef>Sede_t2</flowNodeRef><flowNodeRef>Sede_g1</flowNodeRef><flowNodeRef>Sede_t6</flowNodeRef><flowNodeRef>Sede_g2</flowNodeRef><flowNodeRef>Sede_t8</flowNodeRef><flowNodeRef>Sede_g4</flowNodeRef><flowNodeRef>Sede_t11</flowNodeRef></lane>
<lane id="lane_Sede_J" name="Jefe de logística"><flowNodeRef>Sede_t10</flowNodeRef></lane>
</laneSet>
<startEvent id="Sede_s1" name="Termina el turno"><outgoing>Sede_f0</outgoing></startEvent>
<userTask id="Sede_t1" name="Iniciar sesión"><incoming>Sede_f0</incoming><outgoing>Sede_f1</outgoing></userTask>
<serviceTask id="Sede_t2" name="Mostrar envíos por confirmar"><incoming>Sede_f1</incoming><outgoing>Sede_f2</outgoing></serviceTask>
<exclusiveGateway id="Sede_g1" name="¿Hay un envío nuevo?" gatewayDirection="Diverging"><incoming>Sede_f2</incoming><outgoing>Sede_f3</outgoing><outgoing>Sede_f4</outgoing></exclusiveGateway>
<userTask id="Sede_t3" name="Confirmar si el envío llegó completo"><incoming>Sede_f3</incoming><outgoing>Sede_f5</outgoing></userTask>
<userTask id="Sede_t5" name="Elegir producto e ingresar cantidad usada"><incoming>Sede_f4</incoming><incoming>Sede_f5</incoming><incoming>Sede_f9</incoming><outgoing>Sede_f6</outgoing></userTask>
<serviceTask id="Sede_t6" name="Validar stock y posible duplicado"><incoming>Sede_f6</incoming><outgoing>Sede_f7</outgoing></serviceTask>
<exclusiveGateway id="Sede_g2" name="¿Datos válidos?" gatewayDirection="Diverging"><incoming>Sede_f7</incoming><outgoing>Sede_f8</outgoing><outgoing>Sede_f10</outgoing></exclusiveGateway>
<userTask id="Sede_t7" name="Revisar la cantidad"><incoming>Sede_f8</incoming><outgoing>Sede_f9</outgoing></userTask>
<serviceTask id="Sede_t8" name="Guardar consumo y actualizar stock de la sede"><incoming>Sede_f10</incoming><outgoing>Sede_f11</outgoing></serviceTask>
<exclusiveGateway id="Sede_g3" name="¿Hubo un error?" gatewayDirection="Diverging"><incoming>Sede_f11</incoming><outgoing>Sede_f12</outgoing><outgoing>Sede_f13</outgoing></exclusiveGateway>
<userTask id="Sede_t9" name="Corregir la cantidad o anular el registro"><incoming>Sede_f12</incoming><outgoing>Sede_f14</outgoing></userTask>
<exclusiveGateway id="Sede_g4" name="¿Pasaron más de 24 horas?" gatewayDirection="Diverging"><incoming>Sede_f14</incoming><outgoing>Sede_f15</outgoing><outgoing>Sede_f16</outgoing></exclusiveGateway>
<userTask id="Sede_t10" name="Aprobar o rechazar la corrección"><incoming>Sede_f15</incoming><outgoing>Sede_f17</outgoing></userTask>
<serviceTask id="Sede_t11" name="Aplicar el cambio y guardarlo en registro_error"><incoming>Sede_f16</incoming><incoming>Sede_f17</incoming><outgoing>Sede_f18</outgoing></serviceTask>
<endEvent id="Sede_e1" name="Consumo registrado"><incoming>Sede_f13</incoming><incoming>Sede_f18</incoming></endEvent>
