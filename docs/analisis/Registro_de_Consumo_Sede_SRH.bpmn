<collaboration id="col_Sede"><participant id="pool_Sede" name="Registro de consumo en la sede hospitalaria" processRef="proc_Sede"/></collaboration>
<process id="proc_Sede" name="Registro de consumo en la sede hospitalaria" isExecutable="false"><laneSet id="ls_Sede">
<lane id="lane0" name="Encargado de sede"><flowNodeRef>ini</flowNodeRef><flowNodeRef>t1</flowNodeRef><flowNodeRef>t3</flowNodeRef><flowNodeRef>g2</flowNodeRef><flowNodeRef>t5</flowNodeRef><flowNodeRef>t7</flowNodeRef><flowNodeRef>fin</flowNodeRef></lane>
<lane id="lane1" name="Sistema web"><flowNodeRef>t2</flowNodeRef><flowNodeRef>g1</flowNodeRef><flowNodeRef>t4</flowNodeRef><flowNodeRef>t6</flowNodeRef><flowNodeRef>gp</flowNodeRef><flowNodeRef>t8</flowNodeRef><flowNodeRef>g3</flowNodeRef><flowNodeRef>t9</flowNodeRef></lane>
<lane id="lane2" name="Jefe de logística"><flowNodeRef>t10</flowNodeRef><flowNodeRef>fin2</flowNodeRef></lane>
</laneSet>
<startEvent id="ini" name="Llega un envío o termina el turno"><outgoing>f1</outgoing></startEvent>
<task id="t1" name="Iniciar sesión"><incoming>f1</incoming><outgoing>f2</outgoing></task>
<task id="t2" name="Mostrar envíos por confirmar"><incoming>f2</incoming><outgoing>f3</outgoing></task>
<exclusiveGateway id="g1" name="¿Hay un envío nuevo?"><incoming>f3</incoming><outgoing>f4</outgoing><outgoing>f13</outgoing></exclusiveGateway>
<task id="t3" name="Revisar lo que llegó"><incoming>f4</incoming><outgoing>f5</outgoing></task>
<exclusiveGateway id="g2" name="¿Llegó completo?"><incoming>f5</incoming><outgoing>f6</outgoing><outgoing>f7</outgoing></exclusiveGateway>
<task id="t4" name="Sumar el envío al stock del hospital"><incoming>f6</incoming><outgoing>f14</outgoing></task>
<task id="t5" name="Ingresar la cantidad que llegó"><incoming>f7</incoming><outgoing>f8</outgoing></task>
<task id="t6" name="Descontar la diferencia y guardarla en registro_error"><incoming>f8</incoming><outgoing>f9</outgoing></task>
<parallelGateway id="gp" name=""><incoming>f9</incoming><outgoing>f10</outgoing><outgoing>f12</outgoing></parallelGateway>
<task id="t10" name="Revisar la diferencia (aprobar o rechazar)"><incoming>f10</incoming><outgoing>f11</outgoing></task>
<endEvent id="fin2" name="Diferencia revisada"><incoming>f11</incoming></endEvent>
<task id="t7" name="Elegir producto e ingresar la cantidad usada"><incoming>f12</incoming><incoming>f13</incoming><incoming>f14</incoming><incoming>f18</incoming><outgoing>f15</outgoing></task>
<task id="t8" name="Validar que no supere el stock del hospital"><incoming>f15</incoming><outgoing>f16</outgoing></task>
<exclusiveGateway id="g3" name="¿Datos válidos?"><incoming>f16</incoming><outgoing>f17</outgoing><outgoing>f18</outgoing></exclusiveGateway>
<task id="t9" name="Guardar el consumo con su turno y actualizar el stock"><incoming>f17</incoming><outgoing>f19</outgoing></task>
<endEvent id="fin" name="Consumo registrado"><incoming>f19</incoming></endEvent>
