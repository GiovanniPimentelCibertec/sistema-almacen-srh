<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="def_Actual" targetNamespace="http://almacen.pe/bpmn" exporter="Sistema de Almacén" exporterVersion="1.0">
<collaboration id="col_Actual"><participant id="pool_Actual" name="Proceso actual (Excel y WhatsApp)" processRef="proc_Actual"/></collaboration>
<process id="proc_Actual" name="Proceso actual (Excel y WhatsApp)" isExecutable="false"><laneSet id="ls_Actual">
<lane id="lane_Actual_R" name="Sede"><flowNodeRef>Actual_s1</flowNodeRef><flowNodeRef>Actual_t1</flowNodeRef><flowNodeRef>Actual_t5</flowNodeRef><flowNodeRef>Actual_e3</flowNodeRef></lane>
<lane id="lane_Actual_J" name="Jefe de logística"><flowNodeRef>Actual_t2</flowNodeRef><flowNodeRef>Actual_t3</flowNodeRef><flowNodeRef>Actual_t4</flowNodeRef><flowNodeRef>Actual_g1</flowNodeRef><flowNodeRef>Actual_e1</flowNodeRef><flowNodeRef>Actual_t7</flowNodeRef><flowNodeRef>Actual_e2</flowNodeRef></lane>
<lane id="lane_Actual_P" name="Proveedor"><flowNodeRef>Actual_t6</flowNodeRef></lane>
</laneSet>
<startEvent id="Actual_s1" name="Necesita materiales"><outgoing>Actual_f0</outgoing></startEvent>
<userTask id="Actual_t1" name="Pedir materiales por WhatsApp"><incoming>Actual_f0</incoming><outgoing>Actual_f1</outgoing></userTask>
<userTask id="Actual_t2" name="Leer el pedido en WhatsApp"><incoming>Actual_f1</incoming><outgoing>Actual_f2</outgoing></userTask>
<userTask id="Actual_t3" name="Preparar y enviar lo que hay"><incoming>Actual_f2</incoming><outgoing>Actual_f3</outgoing><outgoing>Actual_f5</outgoing></userTask>
<userTask id="Actual_t5" name="Recibir el pedido (a veces incompleto)"><incoming>Actual_f3</incoming><outgoing>Actual_f4</outgoing></userTask>
<endEvent id="Actual_e3" name="Pedido recibido"><incoming>Actual_f4</incoming></endEvent>
<userTask id="Actual_t4" name="Restar la salida en el Excel"><incoming>Actual_f5</incoming><outgoing>Actual_f6</outgoing></userTask>
<exclusiveGateway id="Actual_g1" name="¿Se ve poco stock? (a ojo)" gatewayDirection="Diverging"><incoming>Actual_f6</incoming><outgoing>Actual_f7</outgoing><outgoing>Actual_f8</outgoing></exclusiveGateway>
<endEvent id="Actual_e1" name="Fin"><incoming>Actual_f7</incoming></endEvent>
<userTask id="Actual_t6" name="Recibir la compra y entregar mercadería"><incoming>Actual_f8</incoming><outgoing>Actual_f9</outgoing></userTask>
<userTask id="Actual_t7" name="Sumar la compra en el Excel"><incoming>Actual_f9</incoming><outgoing>Actual_f10</outgoing></userTask>
<endEvent id="Actual_e2" name="Stock actualizado"><incoming>Actual_f10</incoming></endEvent>
<sequenceFlow id="Actual_f0" sourceRef="Actual_s1" targetRef="Actual_t1"/>
<sequenceFlow id="Actual_f1" sourceRef="Actual_t1" targetRef="Actual_t2"/>
<sequenceFlow id="Actual_f2" sourceRef="Actual_t2" targetRef="Actual_t3"/>
<sequenceFlow id="Actual_f3" sourceRef="Actual_t3" targetRef="Actual_t5"/>
<sequenceFlow id="Actual_f4" sourceRef="Actual_t5" targetRef="Actual_e3"/>
<sequenceFlow id="Actual_f5" sourceRef="Actual_t3" targetRef="Actual_t4"/>
<sequenceFlow id="Actual_f6" sourceRef="Actual_t4" targetRef="Actual_g1"/>
<sequenceFlow id="Actual_f7" name="No" sourceRef="Actual_g1" targetRef="Actual_e1"/>
<sequenceFlow id="Actual_f8" name="Sí: el jefe compra" sourceRef="Actual_g1" targetRef="Actual_t6"/>
<sequenceFlow id="Actual_f9" sourceRef="Actual_t6" targetRef="Actual_t7"/>
<sequenceFlow id="Actual_f10" sourceRef="Actual_t7" targetRef="Actual_e2"/>
</process>
