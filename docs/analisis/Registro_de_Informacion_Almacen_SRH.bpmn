<collaboration id="col_Registro"><participant id="pool_Registro" name="Registro de información en el almacén" processRef="proc_Registro"/></collaboration>
<process id="proc_Registro" name="Registro de información en el almacén" isExecutable="false"><laneSet id="ls_Registro">
<lane id="lane_Registro_U" name="Usuario"><flowNodeRef>Registro_s1</flowNodeRef><flowNodeRef>Registro_t1</flowNodeRef><flowNodeRef>Registro_t3</flowNodeRef><flowNodeRef>Registro_t4</flowNodeRef><flowNodeRef>Registro_g2</flowNodeRef><flowNodeRef>Registro_ta</flowNodeRef><flowNodeRef>Registro_tb</flowNodeRef><flowNodeRef>Registro_tc</flowNodeRef><flowNodeRef>Registro_g3</flowNodeRef><flowNodeRef>Registro_t5</flowNodeRef><flowNodeRef>Registro_t7</flowNodeRef><flowNodeRef>Registro_t11</flowNodeRef><flowNodeRef>Registro_e1</flowNodeRef></lane>
<lane id="lane_Registro_S" name="Sistema web"><flowNodeRef>Registro_t2</flowNodeRef><flowNodeRef>Registro_g1</flowNodeRef><flowNodeRef>Registro_t6</flowNodeRef><flowNodeRef>Registro_g4</flowNodeRef><flowNodeRef>Registro_t10</flowNodeRef><flowNodeRef>Registro_g5</flowNodeRef></lane>
<lane id="lane_Registro_B" name="Base de datos"><flowNodeRef>Registro_t8</flowNodeRef><flowNodeRef>Registro_t9</flowNodeRef></lane>
</laneSet>
<startEvent id="Registro_s1" name="Llega mercadería o un pedido de sede"><outgoing>Registro_f0</outgoing></startEvent>
<userTask id="Registro_t1" name="Iniciar sesión"><incoming>Registro_f0</incoming><incoming>Registro_f4</incoming><outgoing>Registro_f1</outgoing></userTask>
<serviceTask id="Registro_t2" name="Validar usuario y rol"><incoming>Registro_f1</incoming><outgoing>Registro_f2</outgoing></serviceTask>
<exclusiveGateway id="Registro_g1" name="¿Datos correctos?" gatewayDirection="Diverging"><incoming>Registro_f2</incoming><outgoing>Registro_f3</outgoing><outgoing>Registro_f5</outgoing></exclusiveGateway>
<userTask id="Registro_t3" name="Ver mensaje de error"><incoming>Registro_f3</incoming><outgoing>Registro_f4</outgoing></userTask>
<userTask id="Registro_t4" name="Elegir tipo de movimiento"><incoming>Registro_f5</incoming><outgoing>Registro_f6</outgoing></userTask>
<exclusiveGateway id="Registro_g2" name="¿Qué registra?" gatewayDirection="Diverging"><incoming>Registro_f6</incoming><outgoing>Registro_f7</outgoing><outgoing>Registro_f8</outgoing><outgoing>Registro_f9</outgoing></exclusiveGateway>
<userTask id="Registro_ta" name="Ingresar productos y cantidades recibidas"><incoming>Registro_f7</incoming><outgoing>Registro_f10</outgoing></userTask>
<userTask id="Registro_tb" name="Elegir sede, cantidad pedida y despachada"><incoming>Registro_f8</incoming><outgoing>Registro_f11</outgoing></userTask>
<userTask id="Registro_tc" name="Ingresar producto, cantidad y motivo"><incoming>Registro_f9</incoming><outgoing>Registro_f12</outgoing></userTask>
<exclusiveGateway id="Registro_g3" name="" gatewayDirection="Converging"><incoming>Registro_f10</incoming><incoming>Registro_f11</incoming><incoming>Registro_f12</incoming><outgoing>Registro_f13</outgoing></exclusiveGateway>
<userTask id="Registro_t5" name="Guardar"><incoming>Registro_f13</incoming><incoming>Registro_f17</incoming><outgoing>Registro_f14</outgoing></userTask>
<serviceTask id="Registro_t6" name="Validar datos y stock disponible"><incoming>Registro_f14</incoming><outgoing>Registro_f15</outgoing></serviceTask>
<exclusiveGateway id="Registro_g4" name="¿Datos válidos?" gatewayDirection="Diverging"><incoming>Registro_f15</incoming><outgoing>Registro_f16</outgoing><outgoing>Registro_f18</outgoing></exclusiveGateway>
<userTask id="Registro_t7" name="Corregir datos"><incoming>Registro_f16</incoming><outgoing>Registro_f17</outgoing></userTask>
<userTask id="Registro_t8" name="Guardar movimiento y su detalle"><incoming>Registro_f18</incoming><outgoing>Registro_f19</outgoing></userTask>
<userTask id="Registro_t9" name="Actualizar stock y kardex"><incoming>Registro_f19</incoming><outgoing>Registro_f20</outgoing></userTask>
<serviceTask id="Registro_t10" name="Recalcular stock mínimo"><incoming>Registro_f20</incoming><outgoing>Registro_f21</outgoing></serviceTask>
<exclusiveGateway id="Registro_g5" name="¿Quedó bajo el mínimo?" gatewayDirection="Diverging"><incoming>Registro_f21</incoming><outgoing>Registro_f22</outgoing><outgoing>Registro_f23</outgoing></exclusiveGateway>
<userTask id="Registro_t11" name="Ver alerta de reposición"><incoming>Registro_f22</incoming><outgoing>Registro_f24</outgoing></userTask>
<endEvent id="Registro_e1" name="Movimiento registrado"><incoming>Registro_f23</incoming><incoming>Registro_f24</incoming></endEvent>
